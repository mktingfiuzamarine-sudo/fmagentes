API_PORT=3001
REDIS_URL=redis://localhost:6379
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Anon key — used only to verify the dashboard's access tokens.
SUPABASE_ANON_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Optional: tells the dashboard which providers are usable
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=
# Only when a reverse proxy (Traefik) fronts the API: true, a hop count (1), or
# the proxy addresses. Without it every client shares the proxy rate limit.
API_TRUST_PROXY=
# Comma-separated emails or Supabase user ids allowed to call the API.
API_ALLOWED_USERS=
# Optional: CRM (repo "aula") for customer names in the dashboard inbox
CRM_SUPABASE_URL=
CRM_SUPABASE_SERVICE_KEY=
